{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(pip list *)",
      "Bash(.venv/bin/pip list *)",
      "Bash(python -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git branch -D *)",
      "Bash(pip install *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(python -m pip install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.db)",
      "Read(./instance/**)",
      "Edit(./instance/**)",
      "Bash(sqlite3)",
      "Bash(sqlite3 *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_instance.py\""
          }
        ]
      }
    ]
  }
}
